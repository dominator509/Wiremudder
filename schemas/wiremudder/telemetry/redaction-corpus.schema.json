{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremudder.dev/schemas/telemetry/redaction-corpus.schema.json",
  "title": "WireMudder Redaction Corpus",
  "description": "Canonical redaction corpus configuration (SPEC-019-R02, SPEC-019-R05).",
  "type": "object",
  "required": ["schema_version", "markers"],
  "properties": {
    "schema_version": { "const": 1 },
    "markers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
