{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremudder.local/schemas/wiremudder/audio/soundscape-state-v1.json",
  "title": "WireMudder Soundscape State v1",
  "description": "Observable engine state: current soundscape, queue length, transition, mode, failure, stop, and metrics (SPEC-004, EP-026).",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["disabled", "muted", "manual", "auto"] },
    "current": { "type": ["string", "null"] },
    "queue_len": { "type": "integer", "minimum": 0 },
    "transition_active": { "type": "boolean" },
    "dropped": { "type": "integer", "minimum": 0 },
    "coalesced": { "type": "integer", "minimum": 0 },
    "failed": { "type": "boolean" },
    "stopped": { "type": "boolean" }
  },
  "required": ["schema_version", "mode", "current", "queue_len", "transition_active", "dropped", "coalesced", "failed", "stopped"],
  "additionalProperties": false
}
