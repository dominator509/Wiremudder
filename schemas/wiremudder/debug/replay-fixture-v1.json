{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremudder.dev/schemas/debug/replay-fixture-v1.json",
  "title": "WireMudder Trigger Test Lab Replay Fixture",
  "description": "Deterministic fixture events replayed without a live world (SPEC-008, EP-022).",
  "type": "object",
  "required": ["schema_version", "id", "name", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at_step", "line", "matches"],
        "properties": {
          "at_step": { "type": "integer", "minimum": 1 },
          "line": { "type": "string", "minLength": 1 },
          "matches": { "type": "string" },
          "expect": { "type": ["string", "null"] }
        }
      }
    }
  }
}
