{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremudder.dev/schemas/debug/automation-draft-v1.json",
  "title": "WireMudder Macro Forge Automation Draft",
  "description": "Previewable macro/trigger draft that is disabled until approved (SPEC-008, EP-022).",
  "type": "object",
  "required": ["schema_version", "id", "kind", "name", "body", "approved", "preview_only", "created_at_ms"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["macro", "trigger"] },
    "name": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "approved": { "type": "boolean" },
    "preview_only": { "type": "boolean" },
    "created_at_ms": { "type": "integer", "minimum": 0 }
  }
}
