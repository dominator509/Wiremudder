{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorldBrainMemoryFact",
  "description": "Provenance-aware world memory fact (SPEC-012-R02, SPEC-023-R02/R03, EP-021).",
  "type": "object",
  "required": [
    "id", "subject", "attribute", "value", "source_event", "actor",
    "profile_scope", "world_scope", "created_at_ms", "observed_at_ms",
    "confidence", "model_or_rule_version", "sensitivity",
    "supersession", "content_hash"
  ],
  "properties": {
    "id": { "type": "string" },
    "subject": { "type": "string" },
    "attribute": { "type": "string" },
    "value": { "type": "string" },
    "source_event": { "type": "string" },
    "actor": { "type": "string" },
    "profile_scope": { "type": "string" },
    "world_scope": { "type": "string" },
    "created_at_ms": { "type": "integer", "minimum": 0 },
    "observed_at_ms": { "type": "integer", "minimum": 0 },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "model_or_rule_version": { "type": "string" },
    "sensitivity": { "enum": ["public", "private", "secret", "diagnostic"] },
    "supersession": { "enum": ["current", "superseded", "user-corrected"] },
    "correction_note": { "type": ["string", "null"] },
    "content_hash": { "type": "string" }
  }
}
