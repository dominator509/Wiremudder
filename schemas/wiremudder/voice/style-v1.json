{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremudder.dev/schemas/voice/style-v1.json",
  "title": "WireMudder Voice Style",
  "description": "Licensed per-character and per-agent voice style profile; cannot imitate protected characters or celebrities without lawful authorization (SPEC-015-R07; EP-024 WM-FEAT-0064/0065/0212).",
  "type": "object",
  "required": ["id", "label", "kind", "license", "authorized", "protected"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["character", "agent"] },
    "license": { "type": "string", "minLength": 1 },
    "authorized": { "type": "boolean" },
    "protected": { "type": "boolean" }
  }
}
