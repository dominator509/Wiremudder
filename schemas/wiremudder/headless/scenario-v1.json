{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiremudder.dev/schemas/headless/scenario-v1.json",
  "title": "WireMudder Headless Scenario",
  "description": "Schema-validated headless scenario: bounded ordered steps with actions and optional expectations (SPEC-017, EP-023 WM-FEAT-0122).",
  "type": "object",
  "required": ["schema_version", "id", "name", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at_step", "action"],
        "properties": {
          "at_step": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expect": { "type": ["string", "null"] }
        }
      }
    }
  }
}
