{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiremudder.dev/schemas/ai/routing-decision-v1.json",
  "title": "WireMudder AI Routing Decision v1",
  "description": "Deterministic provider routing decision (WM-SPEC-013-R05/R06/R08, WM-FEAT-0038).",
  "type": "object",
  "required": ["schema_version", "decision", "reason"],
  "properties": {
    "schema_version": { "const": 1 },
    "decision": { "enum": ["selected", "no-suggestion", "denied"] },
    "route_id": { "type": "string" },
    "provider_id": { "type": "string" },
    "reason": { "type": "string" },
    "degraded": { "type": "boolean" }
  }
}
