{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wiremudder.dev/schemas/context/usage-v1.json",
  "title": "WireMudder Token Budget Usage Record v1",
  "description": "Token Budget Dashboard record (WM-SPEC-013-R07, WM-FEAT-0049).",
  "type": "object",
  "required": ["schema_version", "provider", "model_family", "feature", "context_tokens", "output_tokens", "estimated_cost_usd_micros", "latency_ms", "cache_status", "reason", "profile_scope"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "type": "string" },
    "model_family": { "type": "string" },
    "feature": { "type": "string" },
    "context_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "estimated_cost_usd_micros": { "type": "integer", "minimum": 0 },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "cache_status": { "type": "string" },
    "reason": { "type": "string" },
    "profile_scope": { "type": "string" }
  }
}
